{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PharmacySystem",
    "Audience": "PharmacySystemUsers",
    "ExpirationMinutes": 60
  },
  "AuthenticationSecurity": {
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Backup": {
    "RetentionCount": 10,
    "MinimumFreeSpaceBytes": 104857600
  }
}
